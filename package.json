{
  "name": "formwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:webkit": "playwright test --project webkit",
    "test:e2e:all": "playwright test",
    "test:e2e:firefox": "playwright test --project firefox",
    "fixture:generate": "tsx scripts/generate-fixture.ts",
    "fixture:build": "npm run fixture:generate && astro build --root fixtures/astro-consumer",
    "fixture:dev": "astro dev --root fixtures/astro-consumer --host 127.0.0.1 --port 4321",
    "fixture:preview": "astro preview --root fixtures/astro-consumer --host 127.0.0.1 --port 4322",
    "fixture:test-server": "npm run fixture:build && npm run fixture:preview",
    "measure": "tsx scripts/measure-exports.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
