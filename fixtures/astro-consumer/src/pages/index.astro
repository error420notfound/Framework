---
import Button from '../generated/Button.astro';
const themes=['light','dark'];
const densities=['comfortable','compact'];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Formwork Astro consumer</title><style>body{font:14px system-ui;margin:32px;color:#334155}h1{font-size:24px}section{padding:24px;margin-block:20px;border:1px solid #e2e8f0;background:var(--fw-surface);color:var(--fw-text_primary)}.row{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-block:24px}h2{font-size:14px}button:focus-visible{outline-style:solid}</style></head><body><h1>Formwork · Astro consumer</h1><p>Generated anatomy and CSS. No editor or client framework runtime.</p>{themes.map(theme=>densities.map(density=><section data-fw-theme={theme} data-fw-density={density}><h2>{theme} / {density}</h2><div class="row">{['primary','secondary'].map(emphasis=>['small','medium','large'].map(size=><Button label={`${emphasis} ${size}`} emphasis={emphasis} size={size}/>))}</div><div class="row"><Button label="Disabled" disabled/><Button label="Loading" loading/><Button label="A deliberately long label that should remain readable"/><Button label="No icon" showIcon={false}/><Button id={`event-${theme}-${density}`} label="Count activation" data-counter="true"/><Button aria-label="Custom accessible name"><span>Slotted label</span><span slot="icon">↗</span></Button></div></section>))}<p>Activations: <output id="activations">0</output></p><script>let count=0;document.querySelectorAll('[data-counter]').forEach(el=>el.addEventListener('click',()=>{document.getElementById('activations')!.textContent=String(++count);}));</script></body></html>
