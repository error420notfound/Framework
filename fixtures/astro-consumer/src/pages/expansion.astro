---
import Button from '../generated/Button.astro';
import Text from '../generated/Text.astro';
import Badge from '../generated/Badge.astro';
import Avatar from '../generated/Avatar.astro';
import Separator from '../generated/Separator.astro';
import Card from '../generated/Card.astro';
import Alert from '../generated/Alert.astro';
import Skeleton from '../generated/Skeleton.astro';
import Spinner from '../generated/Spinner.astro';
import Progress from '../generated/Progress.astro';
import Table from '../generated/Table.astro';
import OutlineButtonwithtrailingicon from '../generated/OutlineButtonwithtrailingicon.astro';
import DestructiveButton from '../generated/DestructiveButton.astro';
import Heading from '../generated/Heading.astro';
import Mutedparagraph from '../generated/Mutedparagraph.astro';
import StatusBadge from '../generated/StatusBadge.astro';
import InitialsAvatar from '../generated/InitialsAvatar.astro';
import Sectionseparator from '../generated/Sectionseparator.astro';
import MetricCard from '../generated/MetricCard.astro';
import InformationalAlert from '../generated/InformationalAlert.astro';
import TextSkeleton from '../generated/TextSkeleton.astro';
import LoadingSpinner from '../generated/LoadingSpinner.astro';
import UploadProgress from '../generated/UploadProgress.astro';
import InvoiceTable from '../generated/InvoiceTable.astro';
---
<!doctype html><html lang="en" data-fw-theme="light" data-fw-density="comfortable"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Formwork expansion showcase</title><link rel="icon" href="data:,"/><style>body{font:14px system-ui;margin:24px;color:#0f172a}main{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:24px}section{border:1px solid #e2e8f0;border-radius:8px;padding:20px;min-width:0;overflow:auto}h1{font-size:28px}.example-label{font-size:16px;margin:0 0 20px}[data-fw-part]{margin-block:0}</style></head><body><h1>Editable starter expansion</h1><main><section data-example="preset_button_outline"><h2 class="example-label">Outline Button with trailing icon</h2><OutlineButtonwithtrailingicon /></section>
<section data-example="preset_button_destructive"><h2 class="example-label">Destructive Button</h2><DestructiveButton /></section>
<section data-example="preset_heading"><h2 class="example-label">Heading</h2><Heading /></section>
<section data-example="preset_muted"><h2 class="example-label">Muted paragraph</h2><Mutedparagraph /></section>
<section data-example="preset_badge_status"><h2 class="example-label">Status Badge</h2><StatusBadge /></section>
<section data-example="preset_avatar"><h2 class="example-label">Initials Avatar</h2><InitialsAvatar /></section>
<section data-example="preset_separator"><h2 class="example-label">Section separator</h2><Sectionseparator /></section>
<section data-example="preset_card_metric"><h2 class="example-label">Metric Card</h2><MetricCard /></section>
<section data-example="preset_alert"><h2 class="example-label">Informational Alert</h2><InformationalAlert /></section>
<section data-example="preset_skeleton"><h2 class="example-label">Text Skeleton</h2><TextSkeleton /></section>
<section data-example="preset_spinner"><h2 class="example-label">Loading Spinner</h2><LoadingSpinner /></section>
<section data-example="preset_progress"><h2 class="example-label">Upload Progress</h2><UploadProgress /></section>
<section data-example="preset_table"><h2 class="example-label">Invoice Table</h2><InvoiceTable /></section><section data-example="long-card"><h2 class="example-label">Long content</h2><Card title="An extended card title that wraps across multiple lines on smaller screens" content="Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. Long content remains editable and wraps safely. " /></section><section data-example="missing-avatar"><h2 class="example-label">Missing image</h2><Avatar image="missing" initials="NA" label="Missing image fallback" /></section></main></body></html>