          "id": "disabled",
          "name": "Disabled",
          "type": "boolean",
          "default": false
        }
      ],
      "axes": {
        "emphasis": [
          "primary",
          "secondary"
        ],
        "size": [
          "small",
          "medium",
          "large"
        ]
      },
      "defaults": {
        "emphasis": "primary",
        "size": "medium"
      },
      "rules": [
        {
          "id": "secondary",
          "name": "Secondary",
          "when": {
            "variants": {
              "emphasis": "secondary"
            },
            "states": []
          },
          "patch": {
            "button_root": {
              "background": {
                "ref": "secondary_fill"
              },
              "color": {
                "ref": "secondary_text"
              },
              "borderColor": {
                "ref": "color_border"
              }
            }
          }
        },
        {
          "id": "small",
          "name": "Small",
          "when": {
            "variants": {
              "size": "small"
            },
            "states": []
          },
          "patch": {
            "button_root": {
              "paddingInline": {
                "value": {
                  "type": "dimension",
                  "value": 12,
                  "unit": "px"
                }
              },
              "paddingBlock": {
                "value": {
                  "type": "dimension",
                  "value": 6,
                  "unit": "px"
                }
              }
            },
            "button_label": {
              "fontSize": {
                "value": {
                  "type": "dimension",
                  "value": 12,
                  "unit": "px"
                }
              }
            }
          }
        },
        {
          "id": "large",
          "name": "Large",
          "when": {
            "variants": {
              "size": "large"
            },
            "states": []
          },
          "patch": {
            "button_root": {
              "paddingInline": {
                "value": {
                  "type": "dimension",
                  "value": 24,
                  "unit": "px"
                }
              },
              "paddingBlock": {
                "value": {
                  "type": "dimension",
                  "value": 14,
                  "unit": "px"
                }
              }
            },
            "button_label": {
              "fontSize": {
                "value": {
                  "type": "dimension",
                  "value": 16,
                  "unit": "px"
                }
              }
            }
          }
        },
        {
          "id": "hover",
          "name": "Hover",
          "when": {
            "variants": {
              "emphasis": "primary"
            },
            "states": [
              "hover"
            ]
          },
          "patch": {
            "button_root": {
              "background": {
                "ref": "hover_fill"
              },
              "borderColor": {
                "ref": "hover_fill"
              }
            }
          }
        },
        {
          "id": "secondaryHover",
          "name": "Secondary hover",
          "when": {
            "variants": {
              "emphasis": "secondary"
            },
            "states": [
              "hover"
            ]
          },
          "patch": {
            "button_root": {
              "background": {
                "ref": "color_canvas"
              }
            }
          }
        },
        {
          "id": "pressed",
          "name": "Pressed",
          "when": {
            "variants": {
              "emphasis": "primary"
            },
            "states": [
              "pressed"
            ]
          },
          "patch": {
            "button_root": {
              "background": {
                "ref": "pressed_fill"
              },
              "borderColor": {
                "ref": "pressed_fill"
              }
            }
          }
        },
        {
          "id": "disabled",
          "name": "Disabled",
          "when": {
            "variants": {},
            "states": [
              "disabled"
            ]
          },
          "patch": {
            "button_root": {
              "background": {
                "ref": "disabled_fill"
              },
              "borderColor": {
                "ref": "disabled_fill"
              },
              "color": {
                "ref": "color_muted"
              }
            }
          }
        },
        {
          "id": "focus",
          "name": "Focus-visible",
          "when": {
            "variants": {},
            "states": [
              "focus-visible"
            ]
          },
          "patch": {
            "button_root": {
              "outlineWidth": {
                "value": {
                  "type": "dimension",
                  "value": 3,
                  "unit": "px"
                }
              },
              "outlineOffset": {
                "value": {
                  "type": "dimension",
                  "value": 3,
                  "unit": "px"
                }
              },
              "outlineColor": {
                "ref": "focus"
              }
            }
          }
        }
      ],
      "behavior": "button",
      "responsive": []
